{
  "name": "create_state",
  "description": "Create a new state.\n\nArgs:\n    project_id: UUID of the project\n    name: State name\n    color: State color (hex color code)\n    description: State description\n    sequence: State sequence order\n    group: State group (e.g., backlog, unstarted, started, completed, cancelled)\n    is_triage: Whether this is a triage state\n    default: Whether this is the default state\n    external_source: External system source name\n    external_id: External system identifier\n\nReturns:\n    Created State object",
  "arguments": {
    "additionalProperties": false,
    "properties": {
      "project_id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "color": {
        "type": "string"
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "sequence": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "group": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "is_triage": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "default": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "external_source": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "external_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "project_id",
      "name",
      "color"
    ],
    "type": "object"
  }
}