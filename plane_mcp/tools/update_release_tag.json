{
  "name": "update_release_tag",
  "description": "Update a release tag by ID. Only the fields you pass are changed.\n\nArgs:\n    tag_id: UUID of the release tag\n    version: Version string, e.g. \"v1.2.0\"\n    description: Notes about the version\n    commit_hash: Git commit the version was cut from\n    git_tag: Corresponding git tag name\n\nReturns:\n    The updated ReleaseTag",
  "arguments": {
    "additionalProperties": false,
    "properties": {
      "tag_id": {
        "type": "string"
      },
      "version": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "commit_hash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "git_tag": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "tag_id"
    ],
    "type": "object"
  }
}