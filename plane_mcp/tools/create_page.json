{
  "name": "create_page",
  "description": "Create a page.\n\nCreates a project page if project_id is given, otherwise a\nworkspace-level page.\n\nArgs:\n    name: Page name\n    description_html: Page content in HTML format\n    project_id: UUID of the project. Omit to create a workspace page.\n    access: Access level for the page (integer)\n    color: Page color\n    is_locked: Whether the page is locked\n    archived_at: Archive timestamp (ISO 8601 format)\n    view_props: View properties dictionary\n    logo_props: Logo properties dictionary\n    external_id: External system identifier\n    external_source: External system source name\n\nReturns:\n    Created Page object",
  "arguments": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string"
      },
      "description_html": {
        "type": "string"
      },
      "project_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "access": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "color": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "is_locked": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "archived_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "view_props": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "logo_props": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "external_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "external_source": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "name",
      "description_html"
    ],
    "type": "object"
  }
}