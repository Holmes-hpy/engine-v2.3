{
  "name": "create_module",
  "description": "Create a new module.\n\nArgs:\n    workspace_slug: The workspace slug identifier\n    project_id: UUID of the project\n    name: Module name\n    description: Module description\n    start_date: Module start date (ISO 8601 format)\n    target_date: Module target/end date (ISO 8601 format)\n    status: Module status (backlog, planned, in-progress, paused, completed, cancelled)\n    lead: UUID of the user who leads the module\n    members: List of user IDs who are members of the module\n    external_source: External system source name\n    external_id: External system identifier\n\nReturns:\n    Created Module object",
  "arguments": {
    "additionalProperties": false,
    "properties": {
      "project_id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "start_date": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "target_date": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "status": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "lead": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "members": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "external_source": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "external_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "project_id",
      "name"
    ],
    "type": "object"
  }
}